{
  "_note": "ACE-T: trained on all 70 skeletons. This is the setting behind the ACE-T row of the paper, which reports the model saved at the end of the run.",
  "scope": "all",
  "run_name": "ace_t",
  "max_steps": 50000,
  "batch_size": 8,
  "lr_g": 0.0001,
  "lr_d": 0.0001,
  "w_adv": 1.0,
  "w_feat": 1.0,
  "gamma_r1": 0.1,
  "p_cluster_uniform": 0.5,
  "seed": 42,
  "log_interval": 200,
  "ckpt_interval": 5000,
  "probe_start_step": 8000,
  "no_resume": false,
  "reset_g_optim": false,
  "skip_feature_check": true,
  "tokenizer_fp16": true,
  "no_source_code": false
}
